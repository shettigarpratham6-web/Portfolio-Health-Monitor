# ==============================================================================
# Portfolio Health Monitor
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your local or production deployment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Runtime
# ------------------------------------------------------------------------------
# Options: development, staging, production, testing
ENVIRONMENT=development
# Set to false in staging/production
DEBUG=true
PROJECT_NAME="Portfolio Health Monitor"
VERSION=0.1.0
API_V1_STR=/api/v1
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# Security & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens and session data.
# In production, must be high-entropy and at least 32 characters long.
# Generate via: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s:%(funcName)s:%(lineno)d - %(message)s"
# Set to true for structured JSON log output (recommended for production)
LOG_JSON_FORMAT=false

# ------------------------------------------------------------------------------
# PostgreSQL Database (REQUIRED for persistence)
# ------------------------------------------------------------------------------
# If DATABASE_URL is set, it takes precedence over discrete POSTGRES_* settings.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentx
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_health
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# LLM Gateway: OpenRouter (REQUIRED in production / agent execution)
# ------------------------------------------------------------------------------
# Obtain API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Research & Web Search: Tavily
# ------------------------------------------------------------------------------
# Obtain API key from https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# ------------------------------------------------------------------------------
# Market Data: Twelve Data API (Stock prices & FX rates)
# ------------------------------------------------------------------------------
# Obtain API key from https://twelvedata.com
TWELVE_DATA_API_KEY=your-twelve-data-api-key-here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Observability & Tracing: LangSmith
# ------------------------------------------------------------------------------
# Set to true to trace multi-agent graph executions in LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=agentx-portfolio-health
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) Ports
# ------------------------------------------------------------------------------
MCP_RESEARCH_SERVER_PORT=8001
MCP_DATABASE_SERVER_PORT=8002
MCP_ANALYSIS_SERVER_PORT=8003

